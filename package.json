{
  "name": "figma-svg-exporter",
  "version": "1.1.1",
  "description": "Export SVG assets from Figma with SVGO optimization and TypeScript type generation",
  "author": "Slava Cherkesov",
  "bin": {
    "figma-svg-exporter": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "lint": "oxlint ./src",
    "lint:fix": "oxlint --fix ./src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "bun run build.ts && tsc -p tsconfig.build.json",
    "release": "semantic-release"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@figma/rest-api-spec": "0.42.0",
    "commander": "15.0.0",
    "svgo": "4.1.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "conventional-changelog-conventionalcommits": "10.4.0",
    "lefthook": "2.1.14",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "semantic-release": "25.0.9",
    "vitest": "5.0.1"
  }
}
